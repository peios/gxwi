load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
    ) + ["build.rs"],
)

rust_library(
    name = "libgxwi",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "gxwi_ffi",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = [
        "//gxwi-abi",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests",
    size = "small",
    crate = ":libgxwi",
)

rust_shared_library(
    name = "shared",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "gxwi_ffi",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["-Clink-arg=-Wl,-soname,libgxwi.so.1"],
    version = VERSION,
    deps = [
        "//gxwi-abi",
    ] + all_crate_deps(normal = True),
)

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"]),
)

exports_files(["exports.txt"])

# Give Bazel's runtime library graph the same filename as the embedded SONAME.
genrule(
    name = "soname",
    srcs = [":shared"],
    outs = ["libgxwi.so.1"],
    cmd = "cp $(execpath :shared) $@",
)

genrule(
    name = "linker-name",
    srcs = [":shared"],
    outs = ["libgxwi.so"],
    cmd = "cp $(execpath :shared) $@",
)

cc_import(
    name = "binary-link",
    interface_library = ":linker-name",
    shared_library = select({
        "//build:native": None,
        "//build:packaged": None,
        "//conditions:default": ":soname",
    }),
    system_provided = select({
        "//build:native": True,
        "//build:packaged": True,
        "//conditions:default": False,
    }),
)

cc_library(
    name = "link",
    hdrs = glob(["include/**/*.h"]),
    strip_include_prefix = "include",
    deps = [
        ":binary-link",
        "@peios_sdk//:peios",
    ],
)

cc_test(
    name = "c-abi-test",
    size = "small",
    srcs = ["tests/abi.c"],
    copts = ["-UNDEBUG"],
    data = [":soname"],
    env = {"LD_LIBRARY_PATH": "libgxwi"},
    deps = [":link"],
)
