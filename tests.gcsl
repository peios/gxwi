# gxwi's tests: each member's unit tests, as `cargo test -p` builds them,
# the restricted worker's again as the static musl program it ships as,
# each member's documentation tests, as `cargo test --doc` runs them,
# Clippy's checks, as `cargo clippy --all-targets -- -Dwarnings` makes them,
# libgxwi's exports and C ABI, and the service worker's script.
#
# A test's own code runs in a hermetic step of its own, so what it plans,
# builds or fetches is in its parameters' defaults.
import fs
import toolchain
import unpack from archive
import Toolchain from toolchain
import BuildEnv from "github.com/gcslib/buildenv"
import "github.com/gcslib/python"
import "github.com/gcslib/rust"
import "github.com/peios/peios-rs" as peios_rs

# The members of the workspace, each a directory of the same name, but
# `gxwi`, which links libgxwi, and is tested on its own.
let MEMBERS = ["gxwi-abi", "gxwi-channel", "gxwi-hello", "gxwi-server", "gxwid", "libgxwi"]

# Where a test that loads libgxwi has it.
let GXWI_LIB = "/opt/gxwi/lib"

# Node.js, which runs the service worker's test, pinned by its SHA-256.
let NODE = "https://nodejs.org/dist/v22.22.1/node-v22.22.1-linux-x64.tar.xz"

# What every test is given: libpeios, by its soname, which a program that
# links it loads (see peios-rs's `runtime`).
def loaded() -> List<{at: String, place: Dir | File}> {
    = peios_rs.runtime()
}

# What a test of the `gxwi` crate is given besides: libgxwi, by its soname.
def loaded_with_libgxwi() -> List<{at: String, place: Dir | File}> {
    = [...peios_rs.runtime(), ...runtime()]
}

# Runs each of `tests`, given `given`, with `env`.
fn ran(tests: List<rust.RustTest>, given: List<{at: String, place: Dir | File}>, env: List<Entry<String>> = peios_rs.runtime_env()) -> {} {
    let each = for test in tests { = rust.run_test(test, given = given, env = env) }
}

def test gxwi_abi(tests: List<rust.RustTest> = rust.tests(crates(), "gxwi-abi")) {
    = ran(tests, [])
}

def test gxwi_channel(tests: List<rust.RustTest> = rust.tests(crates(), "gxwi-channel")) {
    = ran(tests, [])
}

def test gxwi_hello(tests: List<rust.RustTest> = rust.tests(crates(), "gxwi-hello"), given: List<{at: String, place: Dir | File}> = loaded()) {
    = ran(tests, given)
}

def test gxwi_server(tests: List<rust.RustTest> = rust.tests(crates(), "gxwi-server")) {
    = ran(tests, [])
}

# The restricted worker's tests, compiled as the static musl program it
# ships as.
def test gxwi_server_static(tests: List<rust.RustTest> = rust.tests(musl_crates(), "gxwi-server")) {
    = ran(tests, [])
}

# gxwid's tests, some of which run shell commands, given busybox's
# `/bin/sh` and tools.
def test gxwid(
    tests: List<rust.RustTest> = rust.tests(crates(), "gxwid"),
    given: List<{at: String, place: Dir | File}> = loaded(),
    env: BuildEnv = toolchain.get(Toolchain::BuildEnv),
) {
    = ran(tests, [...given, {at = "/bin"; place = env.root.dir("bin")}])
}

def test libgxwi(tests: List<rust.RustTest> = rust.tests(crates(), "libgxwi"), given: List<{at: String, place: Dir | File}> = loaded()) {
    = ran(tests, given)
}

def test gxwi(tests: List<rust.RustTest> = rust.tests(linking_libgxwi(), "gxwi"), given: List<{at: String, place: Dir | File}> = loaded_with_libgxwi()) {
    = ran(tests, given, env = runtime_env())
}

# Each member's documentation tests.
def test doctests(
    ran: List<List<{}>> = [
        ...(for each in MEMBERS { = rust.doctests(crates(), each, given = loaded(), env = peios_rs.runtime_env()) }),
        rust.doctests(linking_libgxwi(), "gxwi", given = loaded_with_libgxwi(), env = runtime_env()),
    ],
) {}

# Clippy's checks of each member, every warning denied.
def test clippy(
    checked: List<List<{}>> = [
        ...(for each in MEMBERS { = rust.clippy(crates(), each, flags = ["-Dwarnings"]) }),
        rust.clippy(linking_libgxwi(), "gxwi", flags = ["-Dwarnings"]),
    ],
) {}

# The binutil `name` of the C toolchain `c`, by its path in a sandbox that
# has the toolchain at `/opt/cc`: `x86_64-linux-nm` beside `x86_64-linux-gcc`.
fn binutil(c: toolchain.CToolchain, name: String): String {
    let cc = c.cc.path.strip_prefix(c.root.path).strip_prefix("/")
    = "/opt/cc/{cc.strip_suffix("gcc")}{name}"
}

# The directory of the C toolchain `c`'s binutils by their plain names,
# `nm` and `readelf`, from its install's root: beside its sysroot.
fn target_tools(c: toolchain.CToolchain): String {
    = "{c.sysroot.path.strip_prefix(c.root.path).strip_prefix("/").strip_suffix("/sysroot")}/bin"
}

# libgxwi exports exactly the functions `libgxwi/exports.txt` lists, is
# `libgxwi.so.1` by its soname, and links libpeios, as
# `tools/check-shared-library.py` checks it with the C toolchain's `nm` and
# `readelf`.
def test shared_library(
    library: File = build libgxwi(),
    sources: List<{at: String, place: Dir | File}> = [
        {at = "/work/libgxwi/exports.txt"; place = file("libgxwi/exports.txt")},
        {at = "/work/tools/check-shared-library.py"; place = file("tools/check-shared-library.py")},
    ],
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
    py: python.PythonToolchain = toolchain.get(Toolchain::Python),
) {
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = c.runtime},
        {at = "/opt/cc"; place = c.root},
        {at = "/opt/python"; place = py.root},
        {at = "/work/libgxwi.so.1"; place = library},
        ...(for each in sources { = {at = each.at; place = each.place} }),
    ]
    let box = fs.compose(placed).sandbox(cwd = "/work", env = {PATH = "/opt/cc/{target_tools(c)}"; PYTHONDONTWRITEBYTECODE = "1"})
    let ran = box.exec("/opt/python/bin/python3", "/work/tools/check-shared-library.py", "/work/libgxwi.so.1")
}

# libgxwi's C ABI: `libgxwi/tests/abi.c`, which includes its header and
# checks its structures' layout and its functions' answers to bad
# arguments, compiled with the C toolchain, linked with libgxwi and run.
def test c_abi(
    library: File = build libgxwi(),
    libpeios: List<{at: String, place: Dir | File}> = peios_rs.runtime(),
    sources: List<{at: String, place: Dir | File}> = [
        {at = "/work/include"; place = dir("libgxwi/include")},
        {at = "/work/abi.c"; place = file("libgxwi/tests/abi.c")},
    ],
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
) {
    let home = working_dir().path
    let made = fs.mkdir("{home}/out")
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = c.runtime},
        {at = "/opt/cc"; place = c.root},
        {at = "{GXWI_LIB}/libgxwi.so"; place = library},
        {at = "{GXWI_LIB}/libgxwi.so.1"; place = library},
        {at = "/work/out"; place = dir("{home}/out")},
        ...(for each in libpeios { = {at = each.at; place = each.place} }),
        ...(for each in sources { = {at = each.at; place = each.place} }),
    ]
    let box = fs.compose(placed).sandbox(cwd = "/work", env = {LD_LIBRARY_PATH = "{GXWI_LIB}:/opt/peios/lib"})
    let compiled = box.exec(
        binutil(c, "gcc"),
        "-UNDEBUG",
        "-I/work/include",
        "/work/abi.c",
        "-L{GXWI_LIB}",
        "-lgxwi",
        "-Wl,-rpath-link,/opt/peios/lib",
        "-o",
        "/work/out/abi",
    )
    let ran = box.exec("/work/out/abi")
}

# The service worker, `gxwi-server/src/sw.js`, as its Node.js test
# `sw.test.mjs` checks it.
def test service_worker(
    node: Dir = unpack(fetch(NODE, sha256 = "9a6bc82f9b491279147219f6a18add1e18424dce90d41d2a5fcd69d4924ba3aa")).dir("node-v22.22.1-linux-x64"),
    sources: List<{at: String, place: Dir | File}> = [
        {at = "/work/sw.js"; place = file("gxwi-server/src/sw.js")},
        {at = "/work/sw.test.mjs"; place = file("gxwi-server/src/sw.test.mjs")},
    ],
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
) {
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = c.runtime},
        {at = "/opt/node"; place = node},
        ...(for each in sources { = {at = each.at; place = each.place} }),
    ]
    let box = fs.compose(placed).sandbox(cwd = "/work", env = {HOME = "/work"})
    let ran = box.exec("/opt/node/bin/node", "--test", "/work/sw.test.mjs")
}
