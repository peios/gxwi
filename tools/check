#!/bin/sh
# The contributor check: owned source style, then pekit's tests, which build
# every member, run their tests, check libgxwi's exports and C ABI and the
# service worker, and check every member with Clippy.
set -eu

repo=$(CDPATH="" cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo"
python3 tools/style-check.py
pekit test
