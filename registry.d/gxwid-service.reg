{
  "_comment": [
    "SeAuditPrivilege is what KMES requires of an emitter: gxwid records each",
    "renewal of the machine's certificate as gxwid.certificate.renewed",
    "(gxwid.evman). It lets gxwid write events, not read them, and not change",
    "audit policy. gxwi-server, under gxwid's restricted token, holds none of",
    "gxwid's privileges but SeChangeNotifyPrivilege."
  ],
  "keys": [
    {
      "path": "Machine\\System\\Services\\gxwid",
      "values": [
        {
          "name": "ImagePath",
          "type": "sz",
          "data": "/usr/bin/gxwid"
        },
        {
          "name": "Identity",
          "type": "sz",
          "data": "SYSTEM"
        },
        {
          "name": "Triggers",
          "type": "multi",
          "data": [
            "boot"
          ]
        },
        {
          "name": "Requires",
          "type": "multi",
          "data": [
            "lpsd"
          ]
        },
        {
          "name": "RequiredPrivileges",
          "type": "multi",
          "data": [
            "SeChangeNotifyPrivilege",
            "SeAssignPrimaryTokenPrivilege",
            "SeTcbPrivilege",
            "SeImpersonatePrivilege",
            "SeAuditPrivilege"
          ]
        },
        {
          "name": "Readiness",
          "type": "dword",
          "data": 1
        },
        {
          "name": "RestartPolicy",
          "type": "dword",
          "data": 1
        },
        {
          "name": "DisplayName",
          "type": "sz",
          "data": "GXWI display server"
        }
      ]
    }
  ]
}
